[schema]
version = 1

[config]
name = "exp_name"
arch = "Aurora"

[random]
seed = 42

[hardware]
gpu = 0

[tensorboard]
enabled = true
path = "runs"

[training]
superbatches = 400
log_every = 10

[training.checkpoint]
location = "checkpoints"
type = "periodic"

[training.checkpoint.periodic]
superbatch = 30

# For one scheduled checkpoint, use type = "single" and replace the table above
# [training.checkpoint.single]
# superbatch = 200

[training.data.buffer]
size_mb = 4096

[training.data.threads]
loader = 4
mapper = 4

[training.data.batch]
size = 16384

[training.data.source.0]
format = "monty"
path = "data/monty_value_00_06.bin"

# [training.data.source.1]
# format = "viri"
# path = "data/viri_data_002_001.vf"

# Text sources require separator, for example, separator = " | "

[training.data.filter]
minimum_ply = 14
# maximum_ply = 90
# minimum_pieces = 0
# minimum_eval = 100
maximum_eval = 8000
exclude_tactical = true
exclude_check = true

[training.optimizer]
minimum_weight = -1.98
maximum_weight = 1.98

[training.optimizer.adamw]
decay = 0.01
beta1 = 0.9
beta2 = 0.999

[training.lr.0]
superbatch_range = [1, 270]
type = "step"

[training.lr.0.step]
gamma = 0.3
start = 0.001
size = 30

[training.lr.1]
superbatch_range = [271, 400]
type = "step"

[training.lr.1.step]
gamma = 0.3
start = 0.0001
size = 20

[training.wdl.0]
superbatch_range = [1, 400]
type = "constant"

[training.wdl.0.constant]
value = 0.0
