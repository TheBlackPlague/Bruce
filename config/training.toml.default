[schema]
version = 1

[config]
name = "exp_name"
arch = "Aurora"

[random]
# Seeds weight initialisation and the order of training data
seed = 42

[hardware]
gpu = 0

[training]
superbatches = 400
log_every = 10
# Directory that receives <name>/metrics.jsonl for bruce-plot; "runs" when omitted
# metrics = "runs"

[training.checkpoint]
location = "checkpoints"
type = "periodic"

[training.checkpoint.periodic]
superbatch = 30

# For one scheduled checkpoint, use type = "single" and replace the table above
# [training.checkpoint.single]
# superbatch = 200

[training.data.buffer]
size_mb = 4096

[training.data.threads]
loader = 4
mapper = 4

[training.data.batch]
size = 16384
# Batches per superbatch; 6104 when omitted
# per_superbatch = 6104

[training.data.source.0]
path = "data/monty_value_00_06.bin"

# Optional per-source key:
# scale = 1.0   multiplies this source's scores after decoding

[training.data.filter]
minimum_ply = 14
# Plies since the first recorded position of each game
# minimum_game_ply = 0
# maximum_ply = 90
# minimum_pieces = 0
# minimum_eval = 100
maximum_eval = 8000
exclude_tactical = true
exclude_check = true

# Results of positions that precede a blunder. Omit the table to use every result as it is.
# type: keep | drop_before | relabel
# [training.data.labels]
# type = "keep"

# A blunder is a move that costs its mover at least this much win probability
# [training.data.labels.blunder]
# swing = 0.30

# Keep or weigh positions by how likely their result is under the score (Stockfish's wld filter)
# [training.data.labels.agreement]
# action = "skip"
# offset = 527
# spread = 287

[training.optimizer]
minimum_weight = -1.98
maximum_weight = 1.98

[training.optimizer.adamw]
decay = 0.01
beta1 = 0.9
beta2 = 0.999

[training.lr.0]
superbatch_range = [1, 270]
type = "step"

[training.lr.0.step]
gamma = 0.3
start = 0.001
size = 30

[training.lr.1]
superbatch_range = [271, 400]
type = "step"

[training.lr.1.step]
gamma = 0.3
start = 0.0001
size = 20

[training.wdl.0]
superbatch_range = [1, 400]
type = "constant"

[training.wdl.0.constant]
value = 0.0
